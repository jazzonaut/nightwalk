// High-quality hash functions for procedural generation
// Used by: window_lit.gdshader, kanji_sign.gdshader, billboard_sign.gdshader

// Single-input hash producing single output
float hash11(float p) {
    p = fract(p * 0.1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}

// Two-input hash producing single output
float hash21(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}
